# Token bot Discord (BẮT BUỘC)
DISCORD_TOKEN=nhập_token_mới_vào_đây

# ID của server chính (tùy chọn)
GUILD_ID=1347141241527341087

# Prefix cho lệnh (tùy chọn)
PREFIX=/*

# Môi trường development/production
NODE_ENV=development

LOG_CHANNEL_ID = 1391903661566988440

CLIENT_ID = 1391897786210979911


# Google Gemini API (lấy key free tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=nhập_key_vào_đây

# Model Gemini (mặc định: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# Số lần gọi AI tối đa mỗi ngày cho cả bot (mặc định: 200)
GEMINI_DAILY_LIMIT=200
